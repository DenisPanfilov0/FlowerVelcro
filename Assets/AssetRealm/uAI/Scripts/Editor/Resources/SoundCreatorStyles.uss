:root {
    --color-background-dark: rgb(35, 35, 35);
    --color-background: rgb(42, 42, 42);
    --color-background-light: rgb(56, 56, 56);
    --color-border-dark: rgb(17, 17, 17);
    --color-border: rgb(60, 60, 60);
    --color-border-light: rgb(80, 80, 80);
    --color-text: rgb(224, 224, 224);
    --color-text-muted: rgb(187, 187, 187);
    --color-accent: rgb(74, 144, 226);
    --color-accent-hover: rgb(90, 160, 242);
    --color-delete: rgb(159, 58, 56);
    --color-delete-hover: rgb(176, 58, 56);
    --color-sfx: rgb(123, 104, 238);
    --color-tts: rgb(32, 178, 170);
    --color-vc: rgb(255, 140, 0);
}

.panel {
    display: none;
    flex-grow: 1;
}

.panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.panel-description {
    font-size: 12px;
    margin-bottom: 15px;
    white-space: normal;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-top: 10px;
    margin-bottom: 5px;
}

.side-panel {
    background-color: rgb(51, 51, 51);
    border-right-width: 1px;
    border-right-color: var(--color-border-dark);
    width: 150px;
}

.sidebar-button {
    -unity-text-align: middle-left;
    padding-left: 16px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--color-text);
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.sidebar-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.sidebar-separator {
    height: 4px;
    background-color: var(--color-background-dark);
    margin-top: 10px;
    margin-bottom: 10px;
}

.settings-button {
    position: relative;
}

.gear-icon {
    width: 16px;
    height: 16px;
    margin-right: 8px;
}

.logo-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: var(--color-accent);
}

Box {
    background-color: rgba(5, 5, 5, 0);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

Label {
    color: var(--color-text);
}

TextField {
    background-color: var(--color-background-light);
    border-color: var(--color-border-light);
    border-radius: 3px;
}

TextField #unity-text-input {
    background-color: rgb(42, 42, 42);
    color: var(--color-text);
}

.unity-base-popup-field__input {
    background-color: rgb(42, 42, 42);
    border-color: var(--color-border-light);
    border-radius: 3px;
    color: var(--color-text);
}

.unity-base-slider__dragger {
    background-color: var(--color-accent);
    border-color: var(--color-accent);
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin-top: -8px;
}

.unity-base-slider__tracker {
    background-color: var(--color-background-light);
    border-color: var(--color-border-light);
    border-radius: 2px;
    height: 4px;
    margin-top: -2px;
}

Button {
    border-radius: 3px;
    background-color: var(--color-background-light);
    color: var(--color-text);
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

Button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.generate-button {
    background-color: var(--color-accent);
    color: white;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
    min-width: 180px;
    height: 40px;
    align-self: center;
    margin-top: 20px;
    margin-bottom: 10px;
}

.generate-button:hover {
    background-color: var(--color-accent-hover);
}

.delete-button {
    background-color: var(--color-delete);
    color: white;
}

.delete-button:hover {
    background-color: var(--color-delete-hover);
}

.back-button {
    margin-bottom: 15px;
    background-color: var(--color-background-dark);
    border-radius: 3px;
    height: 30px;
    width: 150px;
}

.add-button {
    margin-left: 10px;
    margin-bottom: 10px;
    width: 150px;
}

.prompt-container {
    margin-left: 10px;
    margin-right: 10px;
    margin-bottom: 15px;
    background-color: rgba(35, 35, 35, 0);
    border-radius: 5px;
    padding: 10px;
    min-height: 80px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

.settings-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.setting-field {
    width: 280px;
    margin-right: 16px;
    margin-bottom: 12px;
}

.create-subpanel {
    display: none;
}

.placeholder-image {
    height: 40px;
    margin: 0;
    align-items: center;
    justify-content: center;
} 

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
}

.progress-bar {
    width: 200px;
    height: 10px;
    background-color: var(--color-background-dark);
}

.progress-fill {
    width: 0;
    height: 10px;
    background-color: var(--color-accent);
}

.tool-button {
    background-color: var(--color-background-light);
    color: var(--color-text);
    margin-right: 5px;
}

.tool-button.selected {
    background-color: var(--color-accent);
    color: white;
}

.audio-controls {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.preview-image-container {
    background-color: var(--color-background-dark);
    border-radius: 4px;
    min-height: 300px;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 20px;
}

.info-title {
    font-size: 14px;
    -unity-font-style: bold;
    padding: 10px;
    padding-bottom: 5px;
}

.info-label {
    color: var(--color-text-muted);
    -unity-font-style: bold;
    font-size: 12px;
    margin-top: 8px;
    padding-left: 10px;
}

.info-text {
    color: var(--color-text);
    white-space: normal;
    margin-bottom: 8px;
    padding: 0 10px;
}

.action-button {
    margin: 0 8px;
    padding: 8px 16px;
    min-width: 100px;
    background-color: var(--color-background-light);
    color: var(--color-text);
    border-radius: 4px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.date-group {
    margin-bottom: 20px;
}

.date-group > Label {
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    padding-bottom: 6px;
    margin-bottom: 12px;
    -unity-font-style: bold;
    color: var(--color-accent);
}

.sound-item {
    flex-direction: row;
    margin: 5px 0;
    padding: 10px;
    background-color: var(--color-background-dark);
    border-radius: 4px;
    /* cursor: pointer; */
}

.sound-item:hover {
    background-color: var(--color-background);
}

.sound-icon {
    width: 40px;
    height: 40px;
    background-color: var(--color-background);
    border-radius: 4px;
    margin-right: 10px;
    align-items: center;
    justify-content: center;
}

.sound-waveform {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
}


.waveform-bar {
    width: 3px;
    background-color: var(--color-accent);
    margin: 0 1px;
    transition: height 0.3s ease-out;
}

.play-icon {
    position: absolute;
    width: 0;
    height: 0; 
    border-width: 7px 0 7px 12px;
    border-color: transparent transparent transparent var(--color-text);
}

.sound-info {
    flex-grow: 1;
    flex-direction: column;
}

.sound-prompt {
    color: var(--color-text);
    margin-bottom: 5px;
    white-space: normal;
}

.sound-time {
    color: var(--color-text-muted);
    font-size: 11px;
}

.type-badge {
    align-self: flex-start;
    margin-bottom: 5px;
    padding: 2px 6px;
    border-radius: 10px;
    font-size: 10px;
    color: var(--color-text);
    -unity-font-style: bold;
}

.sfx-badge {
    background-color: var(--color-sfx);
}

.tts-badge {
    background-color: var(--color-tts);
}

.vc-badge {
    background-color: var(--color-vc);
}

.waveform-display {
    background-color: var(--color-background);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border);
    flex-direction: row;
    align-items: center;
}

.waveform-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    margin: 0 10px;
    height: 100%;
}

.timeline-slider {
    margin-top: 10px;
}

.loading-modal {
    width: 350px;
    padding: 20px;
    background-color: var(--color-background);
    border-radius: 8px;
    align-items: center;
}

.loading-text {
    color: var(--color-text);
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.progress-container {
    width: 100%;
    height: 20px;
    background-color: var(--color-background-dark);
    border-radius: 10px;
    overflow: hidden;
}

/* For trash items */
.trash-item {
    opacity: 0.7;
}

.trash-actions {
    margin-top: 20px;
    padding-top: 10px;
    border-top-width: 1px;
    border-color: var(--color-border);
}

/* Specialized styles for sound creator */
.prompt-field {
    font-size: 14px;
    background-color: rgba(56, 56, 56, 0);
    min-height: 36px;
    padding: 0 0 5px 0;
    margin: 0 8px;
    -unity-text-align: upper-left;
    white-space: normal;
}

.playhead-indicator {
    position: absolute;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.8);
    height: 100%;
    top: 0;
    transition: left 0.05s linear;
}
 
 
.load-more-button {
    background-color: var(--color-accent);
    color: white;
    padding: 8px 15px;
    font-size: 14px;
    border-radius: 4px;
    min-width: 180px;
    height: 35px;
    align-self: center;
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.load-more-button:hover {
    background-color: var(--color-accent-hover);
}

/* Add this loading indicator styles for the load more button */
.load-more-container {
    align-items: center;
    margin-top: 20px;
    margin-bottom: 20px;
}

.load-more-progress {
    width: 180px;
    height: 4px;
    background-color: var(--color-background-dark);
    margin-top: 5px;
    overflow: hidden;
    display: none;
}

.load-more-progress-fill {
    height: 100%;
    background-color: var(--color-accent);
    width: 30%;
    position: relative;
    /* animation: progress-animation 1s infinite linear; */
}

@keyframes progress-animation {
    0% { left: -30%; }
    100% { left: 100%; }
}

.recording-ui {
    background-color: rgba(42, 42, 42, 0.8);
    border-radius: 4px;
    padding: 8px;
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.recording-indicator {
    width: 12px;
    height: 12px;
    border-radius: 6px;
    background-color: rgb(255, 0, 0);
    margin-right: 10px;
}

.recording-time-label {
    color: var(--color-text);
    margin-right: 15px;
    min-width: 120px;
}

.stop-recording-button {
    background-color: var(--color-delete);
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
}

.stop-recording-button:hover {
    background-color: var(--color-delete-hover);
}