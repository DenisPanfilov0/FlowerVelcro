<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="batch-image-generator-root" class="panel">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" style="flex-grow: 1;">
            
            <ui:Label text="Batch Image Generator" class="panel-title" />
            <ui:Label text="Generate AI images for multiple ScriptableObjects automatically" class="panel-description" />
            
            <!-- Scriptable Objects Section -->
            <ui:Label text="1. Scriptable Objects" class="section-title" />
            <ui:VisualElement class="prompt-container">
                <ui:Button name="add-scriptable-objects-btn" text="Add ScriptableObjects" class="add-button" />
                <ui:ScrollView name="scriptable-objects-list" style="max-height: 150px; margin-top: 10px;">
                </ui:ScrollView>
                <ui:Label name="so-count-label" text="0 objects added" style="margin: 10px; font-size: 12px; color: rgb(187, 187, 187);" />
            </ui:VisualElement>

            <!-- Property Selection Section -->
            <ui:Label text="2. Property Selection" class="section-title" />
            <ui:VisualElement class="prompt-container">
                <ui:DropdownField name="sprite-property-dropdown" label="Sprite Property" class="setting-field" />
                <ui:DropdownField name="naming-property-dropdown" label="Naming Property" class="setting-field" />
                <ui:Label text="Info Properties (for prompts):" style="margin: 5px 0;" />
                <ui:ScrollView name="info-properties-list" style="max-height: 120px;">
                </ui:ScrollView>
            </ui:VisualElement>

            <!-- Prompt Method Section -->
            <ui:Label text="3. Prompt Generation Method" class="section-title" />
            <ui:VisualElement class="prompt-container">
                <ui:VisualElement style="flex-direction: row; margin-bottom: 10px;">
                    <ui:Button name="ai-prompt-btn" text="AI Generated" class="tool-button selected" />
                    <ui:Button name="template-prompt-btn" text="Template Based" class="tool-button" />
                </ui:VisualElement>
                 
                <!-- AI Prompt Section -->
                <ui:VisualElement name="ai-prompt-section">
                    <ui:TextField name="example-prompt-field" label="Example Prompt" multiline="true" class="prompt-field" style="min-height: 60px;" />
                    <ui:Button name="generate-prompts-btn" text="Generate Prompts" class="action-button" />
                    <ui:ScrollView name="generated-prompts-preview" style="max-height: 150px; margin-top: 10px; display: none;">
                    </ui:ScrollView>
                </ui:VisualElement>
                
                <!-- Template Prompt Section -->
                <ui:VisualElement name="template-prompt-section" style="display: none;">
                    <ui:TextField name="template-prompt-field" label="Prompt Template" multiline="true" class="prompt-field" style="min-height: 60px;" value="A stylized, hand-painted fantasy RPG item icon in the style of classic MMORPGs. The icon features [INFOS_HERE], rendered in a semi-realistic digital painting style with clear shapes, fine textured brushwork, and subtle shading. The item is highly readable at small sizes, with realistic proportions and slightly exaggerated details for visual clarity. It is isolated on a dark or neutral background without glow. No text or borders, focused on a polished, game-ready look for inventory use." />
                    <ui:Label text="Use [INFOS_HERE] where you want the ScriptableObject info to be inserted" style="font-size: 11px; color: rgb(187, 187, 187); margin-top: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Image Generation Settings -->
            <ui:Label text="4. Generation Settings" class="section-title" />
            <ui:VisualElement class="prompt-container settings-grid">
                <ui:DropdownField name="model-dropdown" label="Model" class="setting-field" />
                <ui:DropdownField name="size-dropdown" label="Size" class="setting-field" />
                <ui:VisualElement class="setting-field">
                    <ui:Label text="Save Directory" />
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:TextField name="save-path-field" style="flex-grow: 1; margin-right: 5px;" />
                        <ui:Button name="browse-path-btn" text="Browse" style="width: 80px;" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Test Generation Section -->
            <ui:Label text="5. Test Generation" class="section-title" />
            <ui:VisualElement class="prompt-container">
                <ui:Button name="test-generate-btn" text="Generate Test Image" class="generate-button" />
                <ui:VisualElement name="test-result-container" style="display: none; margin-top: 15px;">
                    <ui:VisualElement name="test-image-container" class="preview-image-container" style="margin-bottom: 15px;">
                        <ui:Label text="No test image generated" />
                    </ui:VisualElement>
                    <ui:VisualElement class="action-container">
                        <ui:Button name="approve-test-btn" text="✓ Approve Style" class="action-button" style="background-color: rgb(74, 144, 226);" />
                        <ui:Button name="reject-test-btn" text="✗ Try Again" class="action-button" style="background-color: rgb(159, 58, 56);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Batch Generation Section -->
            <ui:Label text="6. Batch Generation" class="section-title" />
            <ui:VisualElement class="prompt-container">
                <ui:Button name="batch-generate-btn" text="Generate All Images" class="generate-button" style="display: none;" />
                <ui:VisualElement name="batch-progress-container" style="display: none; margin-top: 15px;">
                    <ui:Label name="progress-label" text="Generating images..." />
                    <ui:VisualElement class="progress-bar" style="margin: 10px 0;">
                        <ui:VisualElement name="progress-fill" class="progress-fill" />
                    </ui:VisualElement>
                    <ui:Label name="progress-details" text="" style="font-size: 12px; color: rgb(187, 187, 187);" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Loading Overlay -->
            <ui:VisualElement name="loading-overlay" class="loading-overlay">
                <ui:VisualElement style="background-color: rgba(0, 0, 0, 0.8); padding: 20px; border-radius: 5px; align-items: center;">
                    <ui:Label name="loading-text" text="Processing..." style="color: white; margin-bottom: 10px;" />
                    <ui:VisualElement class="progress-bar">
                        <ui:VisualElement name="loading-progress-fill" class="progress-fill" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:ScrollView>
    </ui:VisualElement>
</ui:UXML>
