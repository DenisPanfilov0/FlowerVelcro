/* Root Container */
.root-container {
    flex: 1;
    background-color: #383838;
    color: #d2d2d2;
}

/* Toolbar Styles */
.toolbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: #393939;
    padding: 8px 12px;
    border-bottom-width: 1px;
    border-bottom-color: #232323;
    height: 40px;
}

.toolbar-section {
    flex-direction: row;
    align-items: center;
}

.toolbar-button {
    margin: 0 4px;
    padding: 6px 16px;
    background-color: #5a5a5a;
    border-color: #232323;
    border-width: 1px;
    border-radius: 3px;
    color: #d2d2d2;
    font-size: 12px;
    -unity-font-style: normal;
}

.toolbar-button:hover {
    background-color: #676767;
    border-color: #3a72b0;
}

.toolbar-button:active {
    background-color: #3a72b0;
    border-color: #3a72b0;
}

.primary-button {
    background-color: #3a72b0;
    border-color: #2d5a8a;
}

.primary-button:hover {
    background-color: #4682c0;
}

.danger-button:hover {
    background-color: #c93030;
    border-color: #c93030;
}

.status-label {
    color: #b4b4b4;
    font-size: 11px;
    -unity-text-align: middle-center;
}

/* Main Content */
.main-content {
    flex: 1;
    flex-direction: row;
}

/* Preview Panel */
.preview-panel {
    flex: 1;
    background-color: #393939;
    border-right-width: 1px;
    border-right-color: #232323;
    padding: 12px;
}

.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: #d2d2d2;
    margin-bottom: 12px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #232323;
}

.image-container {
    flex: 1;
    background-color: #2d2d2d;
    border-width: 1px;
    border-color: #232323;
    border-radius: 3px;
    padding: 20px;
}

.image-preview {
    flex: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-color: #313131;
    border-width: 1px;
    border-color: #232323;
    border-radius: 3px;
    align-items: center;
    justify-content: center;
}

.placeholder-text {
    color: #787878;
    font-size: 14px;
    -unity-text-align: middle-center;
}

/* Controls Panel */
.controls-panel {
    width: 380px;
    background-color: #393939;
    padding: 12px;
}

.controls-scroll {
    flex: 1;
}

/* Control Sections */
.control-section {
    margin-bottom: 8px;
    background-color: #414141;
    border-radius: 3px;
    border-width: 1px;
    border-color: #232323;
}

.control-section > .unity-foldout__toggle {
    background-color: #2d2d2d;
    padding: 8px 12px;
    margin: 0;
    border-radius: 3px 3px 0 0;
}

.control-section > .unity-foldout__toggle:hover {
    background-color: #353535;
}

.control-section > .unity-foldout__toggle > .unity-toggle__input > .unity-toggle__checkmark {
    color: #d2d2d2;
}

.control-section > .unity-foldout__content {
    padding: 8px;
}

.control-group {
    margin-bottom: 12px;
    padding: 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
} 

.control-label {
    font-size: 11px;
    color: #b4b4b4;
    margin-bottom: 6px;
    -unity-font-style: normal;
}

.control-row {
    flex-direction: row;
    align-items: center;
}

.adjustment-slider {
    flex: 1;
    margin-right: 8px;
}

.adjustment-slider .unity-slider__input {
    background-color: #2d2d2d;
    border-color: #232323;
    border-radius: 3px;
    min-height: 18px;
}

.adjustment-slider .unity-slider__dragger {
    background-color: #6a9bd1;
    border-color: #3a72b0;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    top: -6px;
}

.adjustment-slider .unity-slider__tracker {
    background-color: #3a72b0;
    border-radius: 2px;
    height: 3px;
    margin-top: 7px;
}

.value-field {
    width: 60px;
    background-color: #1d1d1d;
    border-color: #232323;
    border-width: 1px;
    border-radius: 3px;
    padding: 4px 8px;
    -unity-text-align: middle-center;
}

.value-field .unity-text-field__input {
    background-color: #1d1d1d;
    border-width: 0;
    color: #d2d2d2;
    font-size: 11px;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
}

/* Effects Section */
.effects-row {
    flex-direction: row;
    justify-content: space-around;
    padding: 8px;
}

.effect-toggle {
    flex-direction: row;
    align-items: center;
    padding: 4px 8px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 3px;
    margin: 0 4px;
}

.effect-toggle:hover {
    background-color: rgba(0, 0, 0, 0.3);
}

.effect-toggle .unity-toggle__input {
    margin-right: 6px;
}

.effect-toggle .unity-toggle__checkmark {
    background-color: #2d2d2d;
    border-color: #232323;
    border-width: 1px;
    border-radius: 3px;
    width: 16px;
    height: 16px;
}

.effect-toggle .unity-toggle__checkmark:checked {
    background-color: #3a72b0;
    border-color: #2d5a8a;
}

.effect-toggle .unity-label {
    color: #d2d2d2;
    font-size: 11px;
    min-width: auto;
    margin: 0;
}

/* Disabled State */
.adjustment-slider:disabled .unity-slider__dragger {
    background-color: #555555;
}

.toolbar-button:disabled {
    opacity: 0.5;
    background-color: #4a4a4a;
}

.effect-toggle:disabled {
    opacity: 0.5;
}

/* Hover Effects */
.control-group:hover {
    background-color: rgba(58, 114, 176, 0.1);
}

/* Focus States */
.value-field:focus .unity-text-field__input {
    border-color: #3a72b0;
    border-width: 1px;
}

/* Scrollbar Styling */
.controls-scroll .unity-scroller--vertical > .unity-slider__tracker {
    background-color: #2d2d2d;
    border-radius: 4px;
}

.controls-scroll .unity-scroller--vertical > .unity-slider__dragger {
    background-color: #555555;
    border-radius: 4px;
    width: 8px;
}

.controls-scroll .unity-scroller--vertical > .unity-slider__dragger:hover {
    background-color: #666666;
}