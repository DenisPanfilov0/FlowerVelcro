Label {
    color: #D2D2D2; 
}

.root-container {
    flex-grow: 1;
    background-color: #383838;
}

.main-container {
    flex-direction: row;
    flex-grow: 1;
}

.left-panel {
    background-color: #2B2B2B;
    border-right-width: 1px;
    border-right-color: #1A1A1A;
    width: 300px;
    padding: 10px;
}

.right-panel {
    flex-grow: 1;
    padding: 10px;
}

.preview-header {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 20px;
    color: #FFFFFF;
}

.section-header {
    font-size: 14px;
    -unity-font-style: bold;
    margin-top: 15px;
    margin-bottom: 10px;
    color: #E0E0E0;
}

ObjectField {
    margin-bottom: 10px;
}

ObjectField > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

IntegerField {
    margin-bottom: 10px;
}

IntegerField > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

Slider {
    margin-bottom: 10px;
}

Slider > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

SliderInt {
    margin-bottom: 10px;
}

SliderInt > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

Toggle {
    margin-bottom: 10px;
}

Toggle > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

ColorField {
    margin-bottom: 10px;
}

ColorField > Label {
    min-width: 120px;
    -unity-text-align: middle-left;
}

Button {
    background-color: #5A9FD4;
    color: #FFFFFF;
    border-radius: 4px;
    border-width: 0;
    height: 30px;
    margin-bottom: 5px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

Button:hover {
    background-color: #6AAEE5;
}

Button:active {
    background-color: #4A8FC4;
}

.button-row {
    flex-direction: row;
    margin-bottom: 10px;
}

.half-width-button {
    flex-grow: 1;
    margin-right: 5px;
}


.export-all-button {
    background-color: #5FBF5F;
}

.export-all-button:hover {
    background-color: #70CF70;
}

.export-selected-button {
    background-color: #5A9FD4;
}

.separator {
    height: 1px;
    background-color: #4A4A4A;
    margin-top: 15px;
    margin-bottom: 15px;
}

.status-label {
    margin-top: 20px;
    white-space: normal;
    color: #B0B0B0;
    font-size: 12px;
}

.parts-count {
    font-size: 12px;
    color: #B0B0B0;
    margin-bottom: 10px;
}

.preview-container {
    background-color: #2B2B2B;
    border-radius: 4px;
    padding: 10px;
    flex-direction: row;
    flex-wrap: wrap;
}

.parts-scroll-view {
    flex-grow: 1;
    background-color: #2B2B2B;
}

.part-preview {
    background-color: #383838;
    border-radius: 4px;
    margin: 5px;
    padding: 10px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    transition-duration: 0.2s;
}

.part-preview:hover {
    background-color: #404040;
}

.part-preview.selected {
    border-color: #5A9FD4;
    background-color: #3A3A3A;
    border-bottom-color: #5A9FD4;
    border-top-color: #5A9FD4;
    border-left-color: #5A9FD4;
    border-right-color: #5A9FD4;
}

.part-preview Image {
    background-color: #1A1A1A;
    border-radius: 4px;
    padding: 5px;
}

.part-info {
    font-size: 11px;
    color: #B0B0B0;
    margin-top: 5px;
    -unity-text-align: middle-center;
}

.part-name-field {
    margin-top: 5px;
    margin-bottom: 5px;
}

.part-name-field > Label {
    min-width: 40px;
    font-size: 11px;
    color: #D2D2D2;
}

.part-name-field .unity-text-field__input {
    background-color: #2B2B2B;
    border-color: #5A5A5A;
    border-width: 1px;
    border-radius: 3px;
    color: #FFFFFF;
    font-size: 11px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
}

.part-name-field .unity-text-field__input:focus {
    border-color: #5A9FD4;
    background-color: #333333;
}

ScrollView {
    background-color: #2B2B2B;
}

ScrollView > #unity-content-viewport {
    background-color: #2B2B2B;
}
 
Scroller {
    background-color: #1A1A1A;
}

Scroller > #unity-low-button {
    background-color: #383838;
}

Scroller > #unity-high-button {
    background-color: #383838;
}

Scroller > #unity-slider > #unity-tracker {
    background-color: #1A1A1A;
}

Scroller > #unity-slider > #unity-dragger {
    background-color: #5A5A5A;
    border-radius: 4px;
}

Scroller > #unity-slider > #unity-dragger:hover {
    background-color: #6A6A6A;
}