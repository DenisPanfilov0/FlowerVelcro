<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <Style src="project://database/Assets/AssetRealm/uAI/Scripts/Editor/Resources/AssetCreatorStyles.uss?fileID=7433441132597879392&amp;guid=68aaab3eccffa7a4e8e15d400445bf82&amp;type=3#AssetCreatorStyles" />
    <ui:VisualElement name="root-element" style="flex-grow: 1;">
        <ui:VisualElement name="main-layout" style="flex-direction: row; flex-grow: 1;">
            <ui:VisualElement name="sidebar" class="side-panel">
                <ui:VisualElement class="title-container" style="height: 50px; min-height: 30px; align-items: center; justify-content: center; margin-top: 10px; margin-bottom: 10px;">
                    <ui:Label text="UAI" name="logo-text" class="logo-text" />
                </ui:VisualElement>
                <ui:Button text="Create" name="create-button" class="sidebar-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; display: none;" />
                <ui:Button text="Creations" name="creations-button" class="sidebar-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:Button text="Trash" name="trash-button" class="sidebar-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:VisualElement class="sidebar-separator" />
                <ui:Button text="Batch Creation" name="batch-button" class="sidebar-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                <ui:VisualElement class="sidebar-separator" />
                <ui:Button name="settings-button" class="sidebar-button settings-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;">
                    <ui:VisualElement style="flex-direction: row; align-items: center;">
                        <ui:VisualElement name="gear-icon" class="gear-icon" />
                        <ui:Label text="Settings" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:VisualElement class="sidebar-separator" />
                <ui:VisualElement style="flex-grow: 1; align-items: center; justify-content: flex-end;">
                    <ui:Button text="Global Settings" name="global-settings-button" class="sidebar-button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: center; justify-content: center; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="main-content" style="flex-grow: 1; flex-direction: column; padding: 15px; background-color: rgb(56, 56, 56);">
                <ui:VisualElement name="creations-panel" class="panel" style="display: flex;">
                    <ui:VisualElement style="flex-direction: row; align-items: center; margin-bottom: 10px; margin-left: 5px;">
                        <ui:Label text="Thumbnail Size:" style="min-width: 100px;" />
                        <ui:Slider name="thumbnail-size-slider" low-value="50" high-value="200" show-input-field="true" value="100" style="width: 200px;" />
                    </ui:VisualElement>
                    <ui:Box style="flex-grow: 1;">
                        <ui:ScrollView name="timeline-scroll-view" style="flex-grow: 1;" />
                    </ui:Box>
                    <ui:VisualElement name="create-panel" class="panel" style="display: flex; position: absolute; background-color: rgba(14, 14, 14, 0.76); border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; bottom: 10px; align-items: auto; align-self: center;">
                        <ui:VisualElement style="flex-direction: column-reverse; flex-grow: 1;">
                            <ui:Box style="flex-grow: 0; -unity-text-align: upper-left; justify-content: flex-end;">
                                <ui:VisualElement style="flex-direction: row;">
                                    <ui:VisualElement name="reference-images-container" style="flex-grow: 1;">
                                        <ui:VisualElement name="reference-thumbnails-container" class="thumbnails-container" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement name="prompt-container" class="prompt-container" style="flex-direction: column; flex-shrink: 0;">
                                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                        <ui:Button text="+" name="add-reference-button" tooltip="Add reference images" class="add-button" style="margin-top: 2px; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 34px; width: 36px; height: 36px;" />
                                        <ui:TextField name="prompt-field" multiline="true" value="Pixel art tileset in a bright, colorful 32-bit RPG style, inspired by games like classic Pocket Monster titles. The tileset should include modular tiles for:&#10;- Grass (with edge variants for cliffs and rivers)&#10;- Dirt paths (with corners and straight segments)&#10;- River water with hexagonal tile patterns and animated flow options&#10;- Wooden bridges (horizontal and vertical)&#10;- Cliffs with shadows and stairs&#10;- Trees (separate top and trunk for layering)&#10;- Bushes, flowers, mushrooms, and tree stumps&#10;- Village buildings with red/brown rooftops and blue windows (roof, wall, door, and window tiles separately)&#10;- Mailbox, wooden signpost, and lamp posts with glow effects&#10;- Light circle overlay tiles for creating lit areas at night&#10;Tiles should be grid-aligned with gaps and modular for seamless tiling, each tile 32×32 pixels. Designed for top-down perspective with subtle shading for depth. Transparent background." class="prompt-field" style="font-size: 14px; background-color: rgba(56, 56, 56, 0); width: 545px; flex-grow: 1; flex-shrink: 1; min-height: 36px; padding-top: 0; padding-right: 0; padding-bottom: 5px; padding-left: 0; margin-left: 8px; margin-right: 8px; -unity-text-align: upper-left; white-space: normal;" />
                                        <ui:Button text="↑" name="generate-button" class="generate-button" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; min-width: 42px; align-self: flex-start; font-size: 19px; border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; width: 46px; max-width: 42px; flex-shrink: 1;" />
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-grow: 1; flex-direction: row;">
                                        <ui:DropdownField name="model-dropdown" tooltip="Model" style="font-size: 12px;" />
                                        <ui:DropdownField name="size-dropdown" tooltip="Image size" style="width: 120px; font-size: 12px;" />
                                        <ui:VisualElement name="size-selection-container" style="flex-direction: row; align-items: center;" />
                                        <ui:DropdownField name="quality-dropdown" tooltip="Quality" style="font-size: 12px;" />
                                        <ui:DropdownField name="count-dropdown" tooltip="Variations" style="font-size: 12px;" />
                                        <ui:Button text="Presets" name="btnShowPreset" tooltip="Add reference images" enable-rich-text="true" class="add-button" style="margin-top: 2px; margin-right: 3px; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 12px; width: 59px; height: 36px;" />
                                        <ui:VisualElement name="placeholder-image" class="placeholder-image" style="flex-grow: 1;">
                                            <ui:VisualElement name="loading-overlay" class="loading-overlay">
                                                <ui:Label text="Generating..." />
                                                <ui:VisualElement name="progress-bar" class="progress-bar">
                                                    <ui:VisualElement name="progress-fill" class="progress-fill" />
                                                </ui:VisualElement>
                                            </ui:VisualElement>
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
                                    <ui:Box name="loading-container" style="flex-grow: 1;" />
                                </ui:VisualElement>
                            </ui:Box>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="preset-selection-overlay" style="flex-grow: 1; position: absolute; flex-shrink: 0; max-width: 100%; max-height: 100%; min-width: 100%; min-height: 100%; background-color: rgba(0, 0, 0, 0.43); justify-content: center; display: none;">
                        <ui:VisualElement style="flex-grow: 0; max-width: 300px; max-height: 300px; align-self: center; min-width: 300px; background-color: rgb(51, 51, 51); padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;">
                            <ui:VisualElement name="header" style="flex-grow: 1; flex-direction: row; min-width: 100%; min-height: 30px; max-height: 50px;">
                                <ui:Label tabindex="-1" text="Preset Selection" parse-escape-sequences="true" display-tooltip-when-elided="true" style="align-items: auto; justify-content: center; flex-grow: 1; -unity-font-style: bold; padding-top: 10px; padding-right: 5px; padding-bottom: 5px; padding-left: 10px;" />
                                <ui:Button text="X" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnClosePreset" style="-unity-text-align: middle-center; align-self: auto; justify-content: flex-end; align-items: auto; background-color: rgba(166, 43, 43, 0.44); min-width: 30px; min-height: 30px;" />
                            </ui:VisualElement>
                            <ui:DropdownField label="Category" index="-1" choices="System.Collections.Generic.List`1[System.String]" name="ddCategory" style="flex-direction: column; height: 50px;" />
                            <ui:DropdownField label="Style" index="-1" choices="System.Collections.Generic.List`1[System.String]" name="ddStyle" style="flex-direction: column; height: 50px;" />
                            <ui:DropdownField label="Sub Category" index="-1" choices="System.Collections.Generic.List`1[System.String]" name="ddSubCategory" style="flex-direction: column; height: 50px;" />
                            <ui:Button text="Select" parse-escape-sequences="true" display-tooltip-when-elided="true" name="btnSelectPreset" style="margin-top: 10px; height: 30px;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="trash-panel" class="panel">
                    <ui:Label text="Trash" class="panel-title" />
                    <ui:Label text="Images moved to trash can be restored or permanently deleted." class="panel-description" />
                    <ui:VisualElement style="flex-direction: row; justify-content: flex-end; margin-bottom: 10px;">
                        <ui:Button text="Empty Trash" name="empty-trash-button" class="delete-button" />
                    </ui:VisualElement>
                    <ui:Box style="flex-grow: 1;">
                        <ui:ScrollView name="trash-scroll-view" style="flex-grow: 1;" />
                    </ui:Box>
                </ui:VisualElement>
                <ui:VisualElement name="mask-drawing-panel" class="panel" style="display: none;">
                    <ui:Label text="Edit Part of Image" class="panel-title" />
                    <ui:Label text="Paint the areas you want to edit (white) or keep (black)." class="panel-description" />
                    <ui:Box class="mask-drawing-container">
                        <ui:IMGUIContainer name="mask-drawing-container" style="min-width: 512px; min-height: 512px;" />
                    </ui:Box>
                    <ui:VisualElement style="flex-grow: 0; flex-direction: row; min-height: 101px;">
                        <ui:VisualElement style="flex-direction: row; margin-bottom: 10px; min-height: 30px; height: 57px; flex-wrap: wrap;">
                            <ui:VisualElement style="flex-direction: row; align-items: center; margin-right: 20px; white-space: normal; text-overflow: clip; flex-wrap: nowrap;">
                                <ui:Label text="Brush Size:" style="min-width: 70px;" />
                                <ui:Slider name="brush-size-slider" low-value="1" high-value="100" show-input-field="true" value="50" style="width: 120px;" />
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; margin-right: 20px;">
                                <ui:Button text="Draw" name="draw-button" class="tool-button selected" />
                                <ui:Button text="Erase" name="erase-button" class="tool-button" />
                            </ui:VisualElement>
                            <ui:Button text="Clear Mask" name="clear-mask-button" class="tool-button" />
                        </ui:VisualElement>
                        <ui:VisualElement style="margin-bottom: 15px; min-height: 60px;">
                            <ui:Label text="Describe what to generate in the highlighted areas:" class="section-title" style="font-size: 12px;" />
                            <ui:TextField name="mask-prompt-field" multiline="true" style="flex-grow: 1;" />
                        </ui:VisualElement>
                        <ui:VisualElement class="action-container" style="flex-shrink: 0; flex-direction: column; flex-grow: 1;">
                            <ui:Button text="Cancel" name="cancel-edit-button" class="action-button" style="min-height: 35px; margin-top: 0; align-self: center; margin-bottom: 11px; display: none;" />
                            <ui:Button text="Generate" name="generate-edit-button" class="generate-button" style="margin-top: 0; margin-bottom: 0;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="image-preview-panel" class="panel" style="display: none;">
                    <ui:Button text="← Back to Creations" name="back-to-creations-button" class="back-button" />
                    <ui:VisualElement style="flex-direction: row; flex-grow: 1;">
                        <ui:Box class="preview-image-container" style="flex-grow: 1; margin-right: 15px;">
                            <ui:Image name="preview-image" style="max-height: 500px;" />
                        </ui:Box>
                        <ui:VisualElement style="width: 300px;">
                            <ui:Box style="margin-bottom: 15px;">
                                <ui:Label text="Image Information" class="info-title" />
                                <ui:Label text="Generated from prompt:" class="info-label" />
                                <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" style="flex-grow: 1; height: 100px; max-height: 90px; min-height: 90px;">
                                    <ui:Label name="prompt-info-label" class="info-text" style="overflow: hidden; padding-top: 10px; padding-right: 10px; padding-bottom: 10px; padding-left: 10px;" />
                                </ui:ScrollView>
                                <ui:Label text="Created on:" class="info-label" />
                                <ui:Label name="date-info-label" class="info-text" />
                            </ui:Box>
                            <ui:Box>
                                <ui:Label text="Quick edits" class="info-title" />
                                <ui:VisualElement style="flex-grow: 1; flex-direction: row; min-height: 228px;">
                                    <ui:VisualElement style="flex-grow: 1;">
                                        <ui:Label text="AI" class="info-title" />
                                        <ui:Button text="Remove &#10;background" name="remove-background-button" class="action-button" />
                                        <ui:Button text="Pixelate" name="pixelate-button" class="action-button" />
                                        <ui:Button text="Make 3D Model" name="make3Dmodel-button" class="action-button" />
                                        <ui:Button text="Separate &#10;into parts" name="separateparts-button" enable-rich-text="false" class="action-button" />
                                    </ui:VisualElement>
                                    <ui:VisualElement style="flex-grow: 1;">
                                        <ui:Label text="Tools" class="info-title" />
                                        <ui:Button text="Background&#10;Remover" name="background-remover-tool-button" enable-rich-text="false" tooltip="Opens the Background Remover tool, which is not as powerful as the AI, but keeps the Image exactly the same." class="action-button" />
                                        <ui:Button text="Part Splitter" name="partsplitter-button" enable-rich-text="false" class="action-button" />
                                        <ui:Button text="PixelArt Scaler" name="pixelartscaler-button" enable-rich-text="false" class="action-button" />
                                        <ui:Button text="Color Correction" name="color-correction-button" enable-rich-text="false" class="action-button" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:Label text="Actions" class="info-title" />
                                <ui:Button text="Use prompt again" name="edit-prompt-button" class="action-button" />
                                <ui:Button text="Edit Image" name="edit-image-button" class="action-button" />
                                <ui:Button text="Edit Part of Image" name="edit-part-button" class="action-button" />
                                <ui:Button text="Export Image" name="export-image-button" class="action-button" />
                                <ui:Button text="Delete Image" name="delete-image-button" class="action-button delete-button" style="background-color: rgb(120, 68, 68);" />
                            </ui:Box>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="settings-panel" class="panel" style="display: none;">
                    <ui:Label text="Settings" class="panel-title" />
                    <ui:Label text="Configure default settings for image generation and save options." class="panel-description" />
                    <ui:Box style="flex-grow: 1; padding: 15px;">
                        <ui:VisualElement>
                            <ui:Label text="Save Location" class="section-title" />
                            <ui:VisualElement style="margin-bottom: 15px;">
                                <ui:Label text="Project Save Path:" style="margin-bottom: 5px;" />
                                <ui:VisualElement style="flex-direction: row;">
                                    <ui:TextField name="save-path-field" style="flex-grow: 1; margin-right: 5px;" />
                                    <ui:Button text="Browse..." name="project-browse-button" style="width: 100px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement style="flex-direction: row; margin-top: 5px; margin-bottom: 10px;">
                                <ui:Toggle name="use-external-path-toggle" label="Save to external location (outside project)" />
                            </ui:VisualElement>
                            <ui:VisualElement name="external-path-container" style="margin-bottom: 20px;">
                                <ui:Label text="External Save Path:" style="margin-bottom: 5px;" />
                                <ui:VisualElement style="flex-direction: row;">
                                    <ui:TextField name="external-path-field" style="flex-grow: 1; margin-right: 5px;" />
                                    <ui:Button text="Browse..." name="browse-path-button" style="width: 100px;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="margin-top: 20px;">
                            <ui:Label text="Default Generation Settings" class="section-title" />
                            <ui:VisualElement class="settings-grid">
                                <ui:VisualElement class="setting-field">
                                    <ui:Label text="Default Model:" />
                                    <ui:DropdownField name="default-model-dropdown" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-field">
                                    <ui:Label text="Default Size:" />
                                    <ui:DropdownField name="default-size-dropdown" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-field">
                                    <ui:Label text="Default Quality:" />
                                    <ui:DropdownField name="default-quality-dropdown" />
                                </ui:VisualElement>
                                <ui:VisualElement class="setting-field">
                                    <ui:Label text="Default Count:" />
                                    <ui:DropdownField name="default-count-dropdown" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement style="flex-direction: row; justify-content: center; margin-top: 30px;">
                            <ui:Button text="Reset to Defaults" name="reset-settings-button" style="margin-right: 10px; width: 150px;" />
                            <ui:Button text="Save Settings" name="save-settings-button" class="generate-button" style="width: 150px;" />
                        </ui:VisualElement>
                    </ui:Box>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
