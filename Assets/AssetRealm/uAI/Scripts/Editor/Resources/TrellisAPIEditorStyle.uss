.main-container {
    flex-direction: column;
    flex-grow: 1;
    min-height: 600px;
    background-color: rgb(56, 56, 56);
}

.header {
    background-color: rgb(42, 42, 42);
    padding: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(35, 35, 35);
    flex-shrink: 0;
}

.header-title {
    font-size: 18px;
    /* font-style: bold; */
    color: rgb(210, 210, 210);
    margin-bottom: 8px;
    -unity-text-align: middle-center;
}

.connection-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.url-field {
    flex-grow: 1;
    margin-right: 10px;
}

.connection-btn {
    width: 120px;
    height: 22px;
    margin-right: 10px;
    background-color: rgb(70, 70, 70);
    border-color: rgb(90, 90, 90);
}

.connection-btn:hover {
    background-color: rgb(80, 80, 80);
}

.connection-indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    font-size: 12px;
    -unity-text-align: middle-center;
    /* font-style: bold; */
}

.connection-indicator.connected {
    background-color: rgb(0, 150, 0);
    color: white;
}

.connection-indicator.disconnected {
    background-color: rgb(150, 0, 0);
    color: white;
}

.content-container {
    flex-direction: row;
    flex-grow: 1;
    min-height: 500px;
}

.left-column {
    flex-basis: 50%;
    background-color: rgb(56, 56, 56);
    padding: 15px;
    border-right-width: 1px;
    border-right-color: rgb(35, 35, 35);
}

.right-column {
    flex-basis: 50%;
    background-color: rgb(48, 48, 48);
    padding: 15px;
    flex-direction: column;
}

.section {
    margin-bottom: 20px;
    padding: 15px;
    background-color: rgb(65, 65, 65);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
}

.section.disabled {
    opacity: 0.5;
}

.section-title {
    font-size: 14px;
    /* font-style: bold; */
    color: rgb(220, 220, 220);
    margin-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(100, 100, 100);
    padding-bottom: 5px;
}

.image-list {
    margin-bottom: 10px;
}

.image-item {
    flex-direction: column;
    margin-bottom: 10px;
    padding: 8px;
    background-color: rgb(75, 75, 75);
    border-radius: 4px;
}

.image-item-header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.image-path {
    flex-grow: 1;
    margin-right: 10px;
}

.image-browse-btn {
    width: 30px;
    height: 20px;
    margin-right: 5px;
}

.image-remove-btn {
    width: 20px;
    height: 20px;
    background-color: rgb(150, 50, 50);
}

.image-preview {
    height: 100px;
    background-color: rgb(60, 60, 60);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    justify-content: center;
    align-items: center;
    margin-top: 5px;
}

.image-preview-content {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    min-width: 100px;
    min-height: 100px;
    background-size: cover;
}

.image-preview-placeholder {
    color: rgb(150, 150, 150);
    /* font-style: italic; */
    font-size: 11px;
    -unity-text-align: middle-center;
}

.add-btn {
    background-color: rgb(74, 144, 226);
    border-color: rgb(44, 92, 143);
    height: 25px;
}

.add-btn:hover {
    background-color: rgb(78, 148, 230);
}

.setting-row {
    margin-bottom: 8px;
    flex-direction: column;
}


.slider-label {
    color: rgb(200, 200, 200);
    margin-bottom: 3px;
    font-size: 12px;
}

.setting-slider {
    margin-bottom: 5px;
}

.dropdown {
    margin-bottom: 5px;
}

.generate-btn {
    height: 35px;
    background-color: rgb(74, 144, 226);
    border-color: rgb(44, 92, 143);
    font-size: 14px;
    /* font-style: bold; */
    color: white;
    margin-top: 15px;
}

.generate-btn:hover {
    background-color: rgb(78, 148, 230);
}

.generate-btn:disabled {
    background-color: rgb(100, 100, 100);
    color: rgb(150, 150, 150);
}

.extraction-buttons {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 10px;
}

.extract-btn {
    flex-basis: 48%;
    height: 30px;
    background-color: rgb(70, 100, 130);
    border-color: rgb(90, 120, 150);
    color: white;
}

.extract-btn:hover {
    background-color: rgb(80, 110, 140);
}

.extract-btn:disabled {
    background-color: rgb(100, 100, 100);
    color: rgb(150, 150, 150);
}

.video-container {
    height: 200px;
    background-color: rgb(30, 30, 30);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
    justify-content: center;
    align-items: center;
    margin-bottom: 10px;
}

.video-placeholder {
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}

.placeholder-text {
    color: rgb(150, 150, 150);
    /* font-style: italic; */
    -unity-text-align: middle-center;
}

.progress-container {
    background-color: rgb(55, 55, 55);
    padding: 10px;
    border-radius: 4px;
}

.progress-info {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 8px;
}

.progress-stage {
    color: rgb(100, 200, 255);
    /* font-style: bold; */
}

.progress-message {
    color: rgb(200, 200, 200);
    font-size: 11px;
}

.progress-bar {
    height: 8px;
    margin-bottom: 5px;
}

.progress-percent {
    color: rgb(180, 180, 180);
    font-size: 10px;
    -unity-text-align: middle-right;
}

.console-container {
    height: 150px;
    background-color: rgb(25, 25, 25);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    margin-bottom: 8px;
}

.console-content {
    padding: 8px;
}

.console-message {
    margin-bottom: 2px;
    font-size: 11px;
    /* font-family: 'Consolas', 'Courier New', monospace; */
}

.console-message.info {
    color: rgb(200, 200, 200);
}

.console-message.warning {
    color: rgb(255, 200, 100);
}

.console-message.error {
    color: rgb(255, 120, 120);
}

.console-message.success {
    color: rgb(120, 255, 120);
}

.clear-console-btn {
    height: 20px;
    width: 60px;
    align-self: flex-end;
    background-color: rgb(80, 80, 80);
    font-size: 10px;
}

.status-bar {
    background-color: rgb(42, 42, 42);
    padding: 5px 10px;
    border-top-width: 1px;
    border-top-color: rgb(35, 35, 35);
    flex-shrink: 0;
}

.status-text {
    color: rgb(180, 180, 180);
    font-size: 11px;
}

.unity-base-field__label {
    color: rgb(200, 200, 200);
    min-width: 120px;
}

.unity-base-field__input {
    background-color: rgb(75, 75, 75);
    border-color: rgb(95, 95, 95);
    color: rgb(220, 220, 220);
}

.unity-slider__tracker {
    background-color: rgb(90, 90, 90);
}

.unity-slider__dragger {
    background-color: rgb(150, 150, 150);
    border-color: rgb(120, 120, 120);
}

.unity-progress-bar__background {
    background-color: rgb(90, 90, 90);
}

.unity-progress-bar__progress {
    background-color: rgb(100, 150, 255);
}