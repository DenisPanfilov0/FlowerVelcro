.panel {
    display: none;
    flex-grow: 1;
}

.panel-title {
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.panel-description {
    font-size: 12px;
    margin-bottom: 15px;
    white-space: normal;
}

.section-title {
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 10px;
    margin-top: 10px;
    margin-bottom: 5px;
}

.side-panel {
    background-color: rgb(51, 51, 51);
    border-right-width: 1px;
    border-right-color: rgb(17, 17, 17);
    width: 150px;
}

/* Sidebar styles */
.sidebar-button {
    -unity-text-align: middle-left;
    padding-left: 16px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(224, 224, 224);
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.sidebar-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.sidebar-button.active {
    background-color: rgba(74, 144, 226, 0.2);
    color: rgb(74, 144, 226);
    -unity-font-style: bold;
}

.sidebar-separator {
    height: 4px;
    background-color: rgb(35, 35, 35);
    margin-top: 10px;
    margin-bottom: 10px;
}

.logo-text {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(74, 144, 226);
}

Box {
    background-color: rgba(5, 5, 5, 0.1);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    margin-bottom: 10px;
}

Label {
    color: rgb(224, 224, 224);
}

TextField {
    background-color: rgb(56, 56, 56);
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
}

TextField #unity-text-input {
    background-color: rgb(42, 42, 42);
    color: rgb(224, 224, 224);
}

.unity-base-popup-field__input {
    background-color: rgb(42, 42, 42);
    border-color: rgb(80, 80, 80);
    border-radius: 3px;
    color: rgb(224, 224, 224);
}

.unity-base-slider__dragger {
    background-color: rgb(74, 144, 226);
    border-color: rgb(74, 144, 226);
    border-radius: 8px;
    width: 16px;
    height: 16px;
    margin-top: -8px;
}

.unity-base-slider__tracker {
    background-color: rgb(56, 56, 56);
    border-color: rgb(80, 80, 80);
    border-radius: 2px;
    height: 4px;
    margin-top: -2px;
}

Button {
    border-radius: 3px;
    background-color: rgb(56, 56, 56);
    color: rgb(224, 224, 224);
    transition-property: background-color;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

Button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.generate-button {
    background-color: rgb(74, 144, 226);
    color: white;
    padding: 10px 20px;
    font-size: 14px;
    border-radius: 4px;
    min-width: 180px;
    height: 40px;
    align-self: center;
    margin-top: 20px;
    margin-bottom: 10px;
}

.generate-button:hover {
    background-color: rgb(90, 160, 242);
}

.action-button {
    margin: 0 8px;
    padding: 8px 16px;
    min-width: 100px;
    background-color: rgb(56, 56, 56);
    color: rgb(224, 224, 224);
    border-radius: 4px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.15);
}

.info-title {
    font-size: 14px;
    -unity-font-style: bold;
    padding: 10px;
    padding-bottom: 5px;
}

.waveform-display {
    height: 100%;
    width: 100%;
    background-color: rgb(42, 42, 42);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    flex-direction: row;
    align-items: center;
    overflow: hidden;
}

.waveform-container {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    margin: 0 10px;
    height: 100%;
    position: relative;
}

.waveform-bar {
    width: 3px;
    background-color: rgb(74, 144, 226);
    margin: 0 1px;
    transition: height 0.3s ease-out;
}

.playhead-indicator {
    position: absolute;
    width: 2px;
    background-color: rgba(255, 255, 255, 0.8);
    height: 100%;
    top: 0;
    transition: left 0.05s linear;
}

.audio-controls {
    flex-direction: row;
    justify-content: center;
    margin-top: 20px;
}

.timeline-slider {
    margin-top: 10px;
}

.raw-waveform-display {
    background-color: rgb(25, 25, 25);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgb(70, 70, 70);
    overflow: hidden;
    position: relative;
}

.raw-waveform-display:hover {
    border-color: rgb(74, 144, 226);
}

.raw-waveform-bar {
    background-color: rgb(100, 180, 255);
    position: absolute;
    width: 1px;
    transition: background-color 0.1s ease-out;
}

.raw-waveform-bar:hover {
    background-color: rgb(120, 200, 255);
}

.timeline-container {
    background-color: rgba(40, 40, 40, 0.8);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.timeline-labels Label {
    font-size: 10px;
    color: rgb(180, 180, 180);
    position: absolute;
    -unity-text-align: middle-center;
}

.unity-scroll-view__horizontal-scroller {
    height: 16px;
    background-color: rgb(35, 35, 35);
}

.unity-scroller__low-button,
.unity-scroller__high-button {
    background-color: rgb(56, 56, 56);
    border-color: rgb(80, 80, 80);
}

.unity-scroller__slider {
    background-color: rgb(74, 144, 226);
}

.unity-scroll-view__content-container {
    min-width: 100%;
}

.selection-indicator {
    background-color: rgba(255, 255, 0, 0.25);
    border-left-width: 2px;
    border-right-width: 2px;
    border-left-color: rgba(255, 255, 0, 0.8);
    border-right-color: rgba(255, 255, 0, 0.8);
    position: absolute;
    top: 0; 
}

.cursor-indicator {
    background-color: rgba(255, 50, 50, 0.9);
    position: absolute;
    top: 0;
    width: 2px; 
    transition: left 0.05s linear;
}

.cursor-indicator:hover {
    background-color: rgba(255, 100, 100, 1);
    width: 3px;
}

.raw-edit-controls {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-top: 20px;
    padding: 10px;
    background-color: rgba(35, 35, 35, 0.5);
    border-radius: 6px;
}

.raw-edit-section {
    flex-direction: column;
    align-items: center;
    margin: 0 10px;
}

.raw-edit-section Label {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 8px;
    color: rgb(200, 200, 200);
}

.raw-edit-button {
    margin: 2px 4px;
    padding: 6px 12px;
    min-width: 60px;
    background-color: rgb(45, 45, 45);
    color: rgb(220, 220, 220);
    border-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    border-width: 1px;
    border-color: rgb(70, 70, 70);
}

.raw-edit-button:hover {
    background-color: rgb(65, 65, 65);
    border-color: rgb(74, 144, 226);
}

.raw-edit-button:disabled {
    background-color: rgb(35, 35, 35);
    color: rgb(120, 120, 120);
    border-color: rgb(50, 50, 50);
}

.zoom-control {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding: 5px;
    background-color: rgba(50, 50, 50, 0.3);
    border-radius: 4px;
}

.zoom-control Label {
    min-width: 60px;
    font-size: 12px;
    margin-right: 10px;
}

.zoom-slider {
    flex-grow: 1;
    margin-right: 10px;
}

.zoom-slider .unity-base-slider__dragger {
    background-color: rgb(255, 140, 0);
    border-color: rgb(255, 140, 0);
}

.raw-info-label {
    font-size: 11px;
    color: rgb(180, 180, 180);
    margin: 2px 0;
    padding: 2px 8px;
    background-color: rgba(40, 40, 40, 0.6);
    border-radius: 3px;
}

.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
    background-color: rgba(35, 35, 35, 0.7); 
}

.loading-modal {
    width: 350px;
    padding: 20px;
    background-color: rgb(42, 42, 42);
    border-radius: 8px;
    align-items: center;
}

.loading-text {
    color: rgb(224, 224, 224);
    -unity-font-style: bold;
    margin-bottom: 15px;
}

.progress-container {
    width: 100%;
    height: 20px;
    background-color: rgb(35, 35, 35);
    border-radius: 10px;
    overflow: hidden;
}

.progress-bar {
    width: 100%;
    height: 10px;
    background-color: rgb(35, 35, 35);
}

.progress-fill {
    width: 0;
    height: 10px;
    background-color: rgb(74, 144, 226);
}

.unity-list-view__item {
    padding: 5px;
    background-color: rgb(35, 35, 35);
    border-bottom-width: 1px;
    border-bottom-color: rgb(60, 60, 60);
}

.unity-list-view__item:hover {
    background-color: rgb(56, 56, 56);
}

.unity-toggle__checkmark {
    background-color: rgb(56, 56, 56);
    border-color: rgb(80, 80, 80);
    border-width: 1px;
    width: 16px;
    height: 16px;
}

.unity-toggle:checked > .unity-toggle__checkmark {
    background-color: rgb(74, 144, 226);
}

.processor-option {
    margin: 5px 0;
}

.processor-option Label {
    margin-left: 5px;
}

.processor-slider-container {
    flex-direction: row;
    align-items: center;
    margin: 10px 0;
}

.processor-slider-container Label {
    min-width: 120px;
}

.clip-info-label {
    color: rgb(187, 187, 187);
    margin: 3px 0;
}

.clips-list-container {
    height: 250px;
    border-width: 1px;
    border-color: rgb(60, 60, 60);
    margin: 10px 0;
    background-color: rgb(35, 35, 35);
}

.processor-panel-layout {
    flex-direction: row;
    flex-grow: 1;
}

.processor-left-panel {
    width: 320px;
    margin-right: 15px;
}

.processor-right-panel {
    flex-grow: 1;
}

@keyframes selection-pulse {
    0% { opacity: 0.3; }
    50% { opacity: 0.6; }
    100% { opacity: 0.3; }
}

.selection-indicator.active {
    /* animation: selection-pulse 1.5s infinite; */
}

@keyframes cursor-blink {
    0% { opacity: 1; }
    50% { opacity: 0.3; }
    100% { opacity: 1; }
}

.cursor-indicator.blinking {
    /* animation: cursor-blink 1s infinite; */
}

@media (max-width: 1200px) {
    .raw-edit-controls {
        flex-direction: column;
        align-items: stretch;
    }
    
    .raw-edit-section {
        margin: 5px 0;
        flex-direction: row;
        justify-content: space-between;
    }
}

.center-content {
    align-items: center;
    justify-content: center;
}

.mt-10 {
    margin-top: 10px;
}

.mb-10 {
    margin-bottom: 10px;
}

.ml-10 {
    margin-left: 10px;
}

.mr-10 {
    margin-right: 10px;
}

.p-10 {
    padding: 10px;
}

.flex-row {
    flex-direction: row;
}

.flex-grow {
    flex-grow: 1;
}

.space-between {
    justify-content: space-between;
}

.raw-edit-tooltip {
    position: absolute;
    background-color: rgba(0, 0, 0, 0.9);
    color: white;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 10px; 
    opacity: 0;
    transition: opacity 0.2s ease-out;
}

.raw-edit-tooltip.visible {
    opacity: 1;
}