#root {
    padding: 10px;
    background-color: rgb(56, 56, 56);
}


.title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(210, 210, 210);
    margin-bottom: 15px;
    padding: 5px;
    background-color: rgb(70, 70, 70);
    border-radius: 5px;
    -unity-text-align: middle-center;
}


.panel-section {
    background-color: rgb(48, 48, 48);
    border-width: 1px;
    border-color: rgb(90, 90, 90);
    border-radius: 5px;
    padding: 10px;
    margin-bottom: 10px;
}

.panel-section:hover {
    background-color: rgb(52, 52, 52);
    border-color: rgb(100, 100, 100);
}


.panel-header {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(220, 220, 220);
    margin-bottom: 8px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 80, 80);
}


#left-panel {
    width: 320px;
    margin-right: 15px;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    padding: 5px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
}


#right-panel {
    flex-grow: 1;
    background-color: rgb(45, 45, 45);
    border-radius: 8px;
    padding: 10px;
    border-width: 1px;
    border-color: rgb(80, 80, 80);
}


#preview-controls {
    background-color: rgb(60, 60, 60);
    border-radius: 5px;
    padding: 8px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: rgb(100, 100, 100);
}


#previewStatusLabel {
    font-size: 12px;
    color: rgb(255, 200, 100);
    -unity-text-align: middle-center; 
    margin-bottom: 5px;
    background-color: rgba(255, 200, 100, 0.1);
    border-radius: 3px;
    padding: 2px 5px;
}


#previewScrollView {
    background-color: rgb(35, 35, 35);
    border-width: 2px;
    border-color: rgb(70, 70, 70);
    border-radius: 5px;
    min-height: 400px;
}

#previewContainer { 
    background-repeat: repeat;
    background-size: 20px 20px;
}

#overlayContainer {
   
}


Button {
    background-color: rgb(70, 70, 70);
    border-color: rgb(90, 90, 90);
    border-width: 1px;
    border-radius: 3px;
    color: rgb(210, 210, 210);
    padding: 4px 8px;
    margin: 2px;
}

Button:hover {
    background-color: rgb(80, 80, 80);
    border-color: rgb(110, 110, 110);
}

Button:active {
    background-color: rgb(60, 60, 60);
    border-color: rgb(120, 120, 120);
}

Button:disabled {
    background-color: rgb(50, 50, 50);
    color: rgb(120, 120, 120);
    border-color: rgb(70, 70, 70);
}


#detectPixelGrid {
    background-color: rgb(50, 80, 120);
}

#detectPixelGrid:hover {
    background-color: rgb(60, 90, 130);
}

#normalScale {
    background-color: rgb(80, 120, 50);
}

#normalScale:hover {
    background-color: rgb(90, 130, 60);
}

#applyColorQuantization {
    background-color: rgb(120, 80, 50);
}

#applyColorQuantization:hover {
    background-color: rgb(130, 90, 60);
}

#applyPredefinedPalette {
    background-color: rgb(100, 60, 120);
}

#applyPredefinedPalette:hover {
    background-color: rgb(110, 70, 130);
}


#previewQuantization {
    background-color: rgb(80, 120, 80);
    color: rgb(220, 255, 220);
}

#previewQuantization:hover {
    background-color: rgb(90, 130, 90);
}

#previewQuantization:disabled {
    background-color: rgb(60, 80, 60);
    color: rgb(140, 160, 140);
}

#saveActiveResult {
    background-color: rgb(50, 120, 80);
}

#saveActiveResult:hover {
    background-color: rgb(60, 130, 90);
}

#saveAllResults {
    background-color: rgb(120, 100, 50);
}

#saveAllResults:hover {
    background-color: rgb(130, 110, 60);
}


IntegerField, FloatField {
    margin: 2px 0;
}

IntegerField > Label, FloatField > Label {
    min-width: 80px;
    color: rgb(200, 200, 200);
}


DropdownField, EnumField {
    margin: 2px 0;
}

DropdownField > Label, EnumField > Label {
    min-width: 80px;
    color: rgb(200, 200, 200);
}


Toggle {
    margin: 2px 0;
}

Toggle > Label {
    color: rgb(200, 200, 200);
}


ObjectField {
    margin: 2px 0;
}

ObjectField > Label {
    min-width: 80px;
    color: rgb(200, 200, 200);
}


.result-item {
    background-color: rgb(55, 55, 55);
    border-width: 1px;
    border-color: rgb(85, 85, 85);
    border-radius: 3px;
    padding: 5px;
    margin: 2px 0;
}

.result-item:hover {
    background-color: rgb(65, 65, 65);
    border-color: rgb(105, 105, 105);
}

.result-toggle {
    flex-grow: 1;
    margin-right: 5px;
}

.visibility-toggle {
    width: 20px;
    margin-left: 5px;
}


.pre-quant-toggle {
    width: 40px;
    margin-left: 5px;
    margin-right: 5px;
    font-size: 10px;
}

.pre-quant-toggle > Label {
    font-size: 10px;
    color: rgb(180, 200, 180);
}

.pre-quant-toggle:checked > Label {
    color: rgb(150, 255, 150);
}

.size-label {
    font-size: 10px;
    color: rgb(180, 180, 180);
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.remove-button {
    width: 20px;
    height: 20px;
    background-color: rgb(120, 50, 50);
    color: rgb(255, 200, 200);
    border-radius: 10px;
    margin-left: 5px;
    font-size: 12px;
    -unity-text-align: middle-center;
}

.remove-button:hover {
    background-color: rgb(140, 60, 60);
}


#quantization-section {
    background-color: rgb(50, 48, 55);
    border-color: rgb(100, 90, 110);
}

#quantization-section .panel-header {
    color: rgb(220, 200, 240);
}


#zoomOut, #zoomIn {
    width: 30px;
    height: 25px;
    font-size: 14px;
    -unity-text-align: middle-center;
    background-color: rgb(80, 80, 80);
}

#zoomOut:hover, #zoomIn:hover {
    background-color: rgb(100, 100, 100);
}

#zoomLabel {
    min-width: 80px;
    -unity-text-align: middle-center;
    color: rgb(200, 200, 200);
    font-size: 11px;
}

#resetView {
    background-color: rgb(60, 90, 60);
}

#resetView:hover {
    background-color: rgb(70, 100, 70);
}


#originalSizeLabel, #resultSizeLabel {
    font-size: 11px;
    color: rgb(180, 180, 180);
    padding: 2px 5px;
    background-color: rgb(40, 40, 40);
    border-radius: 3px;
    margin: 0 2px;
}


ScrollView {
    background-color: rgb(40, 40, 40);
}

ScrollView > #unity-content-container {
    padding: 10px;
}


#activeResults {
    max-height: 250px;
    overflow: hidden;
}

#activeResults ScrollView {
    flex-grow: 1;
}


#colorQuantizationMethod, #predefinedPalette {
    background-color: rgb(60, 55, 65);
}

#maxColors {
    background-color: rgb(60, 55, 65);
}

#enableDithering {
    background-color: rgb(60, 55, 65);
}


.unity-base-field:hover {
    background-color: rgba(255, 255, 255, 0.05);
}

.unity-toggle:hover {
    background-color: rgba(255, 255, 255, 0.03);
}


.result-item.selected {
    background-color: rgb(70, 85, 70);
    border-color: rgb(120, 140, 120);
}
 


.cache-indicator {
    font-size: 9px;
    color: rgb(100, 150, 255); 
    background-color: rgba(100, 150, 255, 0.1);
    border-radius: 2px;
    padding: 1px 3px;
    margin-left: 5px;
}


@media (max-width: 1000px) {
    #left-panel {
        width: 280px;
    }
}

@media (max-width: 800px) {
    #root {
        flex-direction: column;
    }
    
    #left-panel {
        width: auto;
        margin-right: 0;
        margin-bottom: 10px;
    }
}