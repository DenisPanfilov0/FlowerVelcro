/* Main Container */
.main-container {
    flex-grow: 1;
    background-color: #383838;
    flex-direction: column;
}

/* Header Styles */
.header {
    background-color: #2e2e2e;
    padding: 15px; 
    flex-shrink: 0;
}

.header-title {
    font-size: 20px;
    color: #ffffff;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.header-subtitle {
    font-size: 12px;
    color: #b4b4b4;
}

/* Two Column Layout */
.content-container {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

/* Left Column - Options */
.options-column {
    width: 350px;
    background-color: #2e2e2e; 
    padding: 10px;
}

/* Right Column - Image */
.image-column {
    flex-grow: 1;
    background-color: #1e1e1e;
    padding: 10px;
    flex-direction: column;
}

/* Section Styles */
.section {
    background-color: #353535;
    padding: 15px;
    margin-bottom: 10px;
    border-radius: 5px;
}

.section-title {
    font-size: 14px;
    color: #5a9fd4;
    -unity-font-style: bold;
    margin-bottom: 10px;
    padding-bottom: 5px; 
}

.subsection-title {
    font-size: 12px;
    color: #5a9fd4;
    -unity-font-style: bold;
    margin-top: 10px;
    margin-bottom: 5px;
}

/* Zoom Controls Bar */
.zoom-controls-bar {
    flex-direction: row;
    background-color: #353535;
    padding: 5px 10px;
    margin-bottom: 5px;
    border-radius: 3px;
    align-items: center;
    height: 30px;
}

.zoom-label {
    color: #cccccc;
    font-size: 12px;
    margin-right: 5px;
    min-width: 40px;
}

.zoom-slider {
    flex-grow: 1;
    max-width: 200px;
    margin: 0 5px;
}

.zoom-slider Label {
    display: none;
}

.zoom-slider .unity-slider__input {
    width: 50px;
    font-size: 11px;
}

.zoom-reset-button {
    background-color: #4a4a4a;
    color: #ffffff;
    border-width: 0;
    border-radius: 3px;
    padding: 2px 10px;
    font-size: 11px;
    margin: 0 5px;
}

.zoom-reset-button:hover {
    background-color: #5a5a5a;
}

.zoom-help-text {
    color: #999999;
    font-size: 10px;
    margin-left: 10px;
}

/* Image Container */
.image-container {
    flex-grow: 1;
    background-color: #1e1e1e; 
    border-radius: 5px;
    overflow: hidden;
    align-items: center;
    justify-content: center;
}

.image-element {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transform-origin: center;
}

/* Input Field Styles */
.texture-field {
    margin-bottom: 10px;
}

.texture-field Label {
    min-width: 80px;
    color: #cccccc;
}

.algorithm-field {
    margin-bottom: 10px;
}

.algorithm-field Label {
    min-width: 80px;
    color: #cccccc;
}

.algorithm-options {
    margin-top: 10px;
    padding-left: 10px; 
}

.magic-wand-options {
    margin-top: 10px;
}

.eraser-options {
    margin-top: 15px;
    padding: 10px;
    background-color: #2e2e2e;
    border-radius: 3px;
}

.color-field {
    margin-bottom: 10px;
}

.color-field Label {
    min-width: 70px;
    color: #cccccc;
}

/* Parameter Styles */
.parameter-slider {
    margin-bottom: 10px;
}

.parameter-slider Label {
    min-width: 100px;
    color: #cccccc;
}

.parameter-slider .unity-slider__input {
    width: 60px;
}

.parameter-toggle {
    margin-bottom: 10px;
}

.parameter-toggle Label {
    min-width: 100px;
    color: #cccccc;
    flex-grow: 1;
}

/* Selection Controls */
.selection-controls {
    flex-direction: row;
    margin-top: 10px;
    justify-content: space-between;
}

.control-button {
    background-color: #4a4a4a;
    color: #ffffff;
    border-width: 0;
    border-radius: 3px;
    padding: 5px 10px;
    font-size: 12px;
    flex-grow: 1;
    margin: 0 2px;
}

.control-button:hover {
    background-color: #5a5a5a;
}

.control-button:active {
    background-color: #3a3a3a;
}

.control-button:disabled {
    background-color: #333333;
    color: #666666;
}

/* Tool Button Styles */
.tool-button {
    background-color: #4a4a4a;
    color: #ffffff;
    border-width: 0;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: 14px;
    margin-bottom: 10px;
    width: 100%;
}

.tool-button:hover {
    background-color: #5a5a5a;
}

.tool-button:active {
    background-color: #3a3a3a;
}

.tool-button.active {
    background-color: #5a9fd4;
}

/* Help Text */
.help-text {
    font-size: 11px;
    color: #999999;
    margin: 5px 0;
}

/* Button Styles */
.button-container {
    flex-direction: column;
}

.primary-button {
    background-color: #5a9fd4;
    color: #ffffff;
    border-width: 0;
    border-radius: 4px;
    padding: 10px 20px;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.primary-button:hover {
    background-color: #4a8fc4;
}

.primary-button:active {
    background-color: #3a7fb4;
}

.secondary-button {
    background-color: #4a4a4a;
    color: #ffffff;
    border-width: 0;
    border-radius: 4px;
    padding: 8px 20px;
    font-size: 14px;
    margin-bottom: 5px;
}

.secondary-button:hover {
    background-color: #5a5a5a;
}

.secondary-button:active {
    background-color: #3a3a3a;
}

/* Status Bar */
.status-bar {
    background-color: #2e2e2e;
    padding: 10px; 
    flex-shrink: 0;
}

.status-label {
    color: #b4b4b4;
    font-size: 12px;
}

/* Hover Effects */
.unity-object-field:hover {
    background-color: #3a3a3a;
}

.unity-enum-field:hover {
    background-color: #3a3a3a;
}

.unity-color-field:hover {
    background-color: #3a3a3a;
}

.unity-slider:hover {
    background-color: #3a3a3a;
}

.unity-toggle:hover {
    background-color: #3a3a3a;
}

/* Focus Effects */
.unity-base-field:focus .unity-base-field__input {
    border-color: #5a9fd4;
}

/* Scrollbar Styling */
.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical > .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical > .unity-scroller__slider {
    background-color: #2e2e2e;
    border-radius: 3px;
    width: 10px;
}

.unity-scroller--vertical > .unity-scroller__slider:hover {
    background-color: #3e3e3e;
}

.unity-scroller--vertical > .unity-scroller__slider > .unity-slider__drag-container > .unity-slider__dragger {
    background-color: #5a9fd4;
    border-radius: 3px;
    width: 10px;
    left: 0;
}

/* Selection Overlay Animation */
.image-element VisualElement {
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
}