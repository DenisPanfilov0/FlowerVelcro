<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:VisualElement class="main-container">
        <!-- Header -->
        <ui:VisualElement class="header">
            <ui:Label text="Background Remover" class="header-title" />
            <ui:Label text="Professional image background removal tool" class="header-subtitle" />
        </ui:VisualElement>
        
        <!-- Two Column Layout -->
        <ui:VisualElement class="content-container">
            
            <!-- Left Column - Options -->
            <ui:ScrollView class="options-column">
                
                <!-- Source Texture Section -->
                <ui:VisualElement class="section">
                    <ui:Label text="Source Image" class="section-title" />
                    <uie:ObjectField name="SourceTexture" 
                                    label="Texture" 
                                    object-type="UnityEngine.Texture2D" 
                                    class="texture-field" />
                </ui:VisualElement>
                
                <!-- Algorithm Selection -->
                <ui:VisualElement class="section">
                    <ui:Label text="Algorithm Settings" class="section-title" />
                    <uie:EnumField name="AlgorithmField" 
                                  label="Algorithm" 
                                  value="ColorKey"
                                  class="algorithm-field" />
                    
                    <!-- Algorithm-specific options -->
                    <ui:VisualElement name="AlgorithmOptions" class="algorithm-options">
                        <ui:VisualElement>
                            <uie:ColorField name="ColorKeyField" 
                                           label="Key Color" 
                                           value="#00FF00"
                                           show-alpha="false"
                                           class="color-field" />
                        </ui:VisualElement>
                        
                        <!-- Magic Wand specific options -->
                        <ui:VisualElement name="MagicWandOptions" class="magic-wand-options">
                            <ui:Toggle name="AdjacentToggle" 
                                      label="Contiguous"
                                      value="true"
                                      class="parameter-toggle" />
                            <ui:Label text="Click to select. Shift+Click to add. Ctrl+Click to remove." 
                                     class="help-text" />
                            <ui:VisualElement class="selection-controls">
                                <ui:Button name="UndoButton" text="Undo" class="control-button" />
                                <ui:Button name="RedoButton" text="Redo" class="control-button" />
                                <ui:Button name="ClearSelectionButton" text="Clear" class="control-button" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        
                        <!-- Eraser Tool Options -->
                        <ui:VisualElement name="EraserOptions" class="eraser-options">
                            <ui:Label text="Eraser Tool" class="subsection-title" />
                            <ui:Button name="EraserButton" text="Eraser" class="tool-button" />
                            <ui:Slider name="EraserSizeSlider" 
                                      label="Brush Size" 
                                      low-value="1" 
                                      high-value="50" 
                                      value="10"
                                      show-input-field="true"
                                      class="parameter-slider" />
                            <ui:Label text="Shift+Drag to add. Drag to remove." 
                                     class="help-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <!-- Parameters Section -->
                <ui:VisualElement class="section">
                    <ui:Label text="Parameters" class="section-title" />
                    
                    <ui:Slider name="ToleranceSlider" 
                              label="Tolerance" 
                              low-value="0" 
                              high-value="1" 
                              value="0.2"
                              show-input-field="true"
                              class="parameter-slider" />
                    
                    <ui:Slider name="EdgeSoftnessSlider" 
                              label="Edge Softness" 
                              low-value="0" 
                              high-value="0.5" 
                              value="0"
                              show-input-field="true"
                              class="parameter-slider" />
                    
                    <ui:Toggle name="InvertSelectionToggle" 
                              label="Invert Selection"
                              class="parameter-toggle" />
                    
                    <ui:Toggle name="PreserveAlphaToggle" 
                              label="Preserve Original Alpha"
                              class="parameter-toggle" />
                </ui:VisualElement>
                
                <!-- Action Buttons -->
                <ui:VisualElement class="section">
                    <ui:Label text="Actions" class="section-title" />
                    <ui:VisualElement class="button-container">
                        <ui:Button name="DeleteAreaButton" text="Delete Selected Area (Del)" class="primary-button" />
                        <ui:Button name="SaveButton" text="Save Result" class="secondary-button" />
                        <ui:Button name="ResetButton" text="Reset All" class="secondary-button" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
            </ui:ScrollView>
            
            <!-- Right Column - Image Preview -->
            <ui:VisualElement class="image-column">
                <!-- Zoom Controls - Moved above image -->
                <ui:VisualElement class="zoom-controls-bar">
                    <ui:Label text="Zoom:" class="zoom-label" />
                    <ui:Slider name="ZoomSlider" 
                              low-value="1" 
                              high-value="10" 
                              value="1"
                              show-input-field="true"
                              class="zoom-slider" />
                    <ui:Button name="ResetZoomButton" text="Reset" class="zoom-reset-button" />
                    <ui:Label text="Right-click: Pan | Scroll: Zoom" class="zoom-help-text" />
                </ui:VisualElement>
                
                <ui:VisualElement name="ImageContainer" class="image-container">
                    <ui:VisualElement name="ImageElement" class="image-element" />
                </ui:VisualElement>
            </ui:VisualElement>
            
        </ui:VisualElement>
        
        <!-- Status Bar -->
        <ui:VisualElement class="status-bar">
            <ui:Label name="StatusLabel" text="Ready" class="status-label" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>