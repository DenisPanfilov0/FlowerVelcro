/* Import base styles - this would reference the main USS file */

#batch-image-generator-root {
    padding: 20px;
    flex-grow: 1;
}

/* Scriptable Object List Items */
.so-list-item {
    flex-direction: row;
    align-items: center;
    padding: 8px;
    margin-bottom: 4px;
    background-color: var(--color-background-light);
    border-radius: 3px;
    border-left-width: 3px;
    border-left-color: var(--color-accent);
}

.so-list-item Label {
    flex-grow: 1;
    margin-right: 10px;
    color: var(--color-text);
}

.so-list-item .delete-button {
    width: 20px;
    height: 20px;
    padding: 0;
    font-size: 12px;
    border-radius: 2px;
}

/* Property Selection */
.property-checkbox {
    margin: 4px 8px;
    flex-direction: row;
    align-items: center;
}

.property-checkbox Label {
    margin-left: 8px;
    color: var(--color-text);
}

/* Prompt Method Buttons */
.tool-button {
    background-color: var(--color-background-light);
    color: var(--color-text);
    margin-right: 5px;
    padding: 8px 16px;
    border-radius: 3px;
    min-width: 120px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.tool-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

.tool-button.selected {
    background-color: var(--color-accent);
    color: white;
}

/* Generated Prompts Preview */
.prompt-preview-item {
    background-color: var(--color-background-dark);
    border-radius: 4px;
    padding: 10px;
    margin-bottom: 8px;
    border-left-width: 3px;
    border-left-color: var(--color-accent);
}

.prompt-preview-title {
    color: var(--color-accent);
    margin-bottom: 5px;
    font-size: 12px;
}

.prompt-preview-text {
    color: var(--color-text);
    white-space: normal;
    font-size: 11px;
}

/* Test Image Container */
.test-image-display {
    max-width: 256px;
    max-height: 256px;
    align-self: center;
    border-radius: 4px;
}

/* Progress Bar Enhancements */
.progress-bar {
    width: 100%;
    height: 8px;
    background-color: var(--color-background-dark);
    border-radius: 4px;
    overflow: hidden;
}

.progress-fill {
    height: 100%;
    background-color: var(--color-accent);
    transition-property: width;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}

/* Action Buttons */
.action-button {
    margin: 0 8px;
    padding: 8px 16px;
    min-width: 100px;
    background-color: var(--color-background-light);
    color: var(--color-text);
    border-radius: 4px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.action-button:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

/* Loading Overlay */
.loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.5);
    display: none;
}

/* Settings Grid Enhancement */
.settings-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-start;
}

.setting-field {
    width: 280px;
    margin-right: 16px;
    margin-bottom: 12px;
}

/* Validation States */
.field-valid {
    border-left-width: 3px;
    border-left-color: rgb(74, 144, 226);
}

.field-invalid {
    border-left-width: 3px;
    border-left-color: rgb(159, 58, 56);
}

.field-warning {
    border-left-width: 3px;
    border-left-color: rgb(255, 193, 7);
}

/* Status Messages */
.status-message {
    padding: 8px 12px;
    border-radius: 4px;
    margin: 8px 0;
    font-size: 12px;
}

.status-success {
    background-color: rgba(74, 144, 226, 0.2);
    color: rgb(74, 144, 226);
    border-left-width: 3px;
    border-left-color: rgb(74, 144, 226);
}

.status-error {
    background-color: rgba(159, 58, 56, 0.2);
    color: rgb(159, 58, 56);
    border-left-width: 3px;
    border-left-color: rgb(159, 58, 56);
}

.status-warning {
    background-color: rgba(255, 193, 7, 0.2);
    color: rgb(255, 193, 7);
    border-left-width: 3px;
    border-left-color: rgb(255, 193, 7);
}

/* Disabled States */
.disabled {
    opacity: 0.5;
}

/* Responsive adjustments */
@media (max-width: 600px) {
    .settings-grid {
        flex-direction: column;
    }
    
    .setting-field {
        width: 100%;
        margin-right: 0;
    }
}

/* Scroll View Styling */
.unity-scroll-view {
    background-color: var(--color-background-dark);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border);
}

.unity-scroll-view__content-viewport {
    background-color: transparent;
}

.unity-scroll-view__content-container {
    padding: 8px;
}

/* Enhanced Button States */
.generate-button:disabled {
    background-color: var(--color-background-dark);
    color: var(--color-text-muted);
    opacity: 0.6;
}

.add-button:hover {
    background-color: var(--color-accent);
    color: white;
}

/* Object Field Styling */
.unity-object-field {
    background-color: var(--color-background-light);
    border-color: var(--color-border-light);
    border-radius: 3px;
}

.unity-object-field__input {
    background-color: var(--color-background-light);
    color: var(--color-text);
}

/* Enhanced Dropdown Styling */
.unity-base-dropdown {
    background-color: var(--color-background-light);
    border-color: var(--color-border-light);
}

.unity-base-dropdown__input {
    background-color: var(--color-background-light);
    color: var(--color-text);
}

/* Browse Button Styling */
.setting-field Button {
    background-color: var(--color-accent);
    color: white;
    border-radius: 3px;
    font-size: 12px;
    padding: 6px 12px;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.setting-field Button:hover {
    background-color: var(--color-accent-hover);
}