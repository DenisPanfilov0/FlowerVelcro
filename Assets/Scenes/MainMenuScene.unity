  m_text: "\u0412\u044B\u0431\u0435\u0440\u0438 \u043E\u0431\u0440\u0430\u0437 \u043F\u0435\u0440\u0432\u044B\u0439
    \u0441\u0442\u0438\u043A\u0435\u0440 - \u043E\u0431\u0440\u0430\u0437. \u041E\u0431\u0440\u0430\u0442\u0438
    \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435, \u0447\u0442\u043E\u0431 \u043F\u043E\u0441\u043B\u0435
    \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u044F \u0442\u044B \u0441\u043C\u043E\u0436\u0435\u0448\u044C
    \u0438\u0437\u043C\u0435\u043D\u0438\u0442\u044C \u0440\u0430\u0437\u043C\u0435\u0440,
    \u043F\u043E\u0432\u043E\u0440\u043E\u0442 \u0438\u043B\u0438 \u043F\u0440\u043E\u0441\u0442\u043E
    \u0443\u0434\u0430\u043B\u0438\u0442\u044C \u043D\u0435\u043D\u0443\u0436\u043D\u044B\u0439
    \u0441 \u0445\u043E\u043B\u0441\u0442\u0430"
