  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0412 \u044D\u0442\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435,
    \u0442\u0432\u043E\u044F \u0437\u0430\u0434\u0430\u0447\u0430 \u0441\u043A\u0438\u0434\u044B\u0432\u0430\u0442\u044C
    \u0441\u0432\u0435\u0440\u0445\u0443 \u0432\u043D\u0438\u0437 \u043B\u0430\u0431\u0443\u0431\u0443
    \u0434\u043B\u044F \u043E\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F
    \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u044B\u0445. \u0417\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
    \u0435\u0431\u044A\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u0435 \u0442\u044B
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0448\u044C \u043E\u0447\u043A\u0438
    \u0438 \u043F\u043E 3 \u0421\u0430\u0445\u0430\u0440\u0430. \u0415\u0441\u043B\u0438
    \u043B\u0430\u0431\u0443\u0431\u0443 \u0431\u0443\u0434\u0443\u0442 \u0432\u044B\u043F\u0430\u0434\u0430\u0442\u044C
    \u0438\u0437 \u0441\u0442\u0430\u043A\u0430\u043D\u0430, \u0442\u043E \u0438\u0433\u0440\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0441\u044F. \n\n\u041D\u0430\u0431\u0435\u0440\u0438
    \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0441\u0435\u0445 \u043E\u0447\u043A\u043E\u0432
    \u0438 \u0441\u043E\u0435\u0434\u0435\u043D\u0438 \u0441\u043E\u0431\u0435\u0440\u0438
    \u0432\u0441\u0435\u0445 \u043B\u0430\u0431\u0443\u0431\u0443\n\n\u0423\u0434\u0430\u0447\u0438!"
